[options]
; ---------------------------------------------------------------------------
; Modelo de configuração. O instalar.sh copia este arquivo para etc/odoo.conf
; (não versionado) e preenche os campos __ENTRE_SUBLINHADOS__.
; Referência completa das opções: odoo --help
; ---------------------------------------------------------------------------

addons_path = /mnt/extra-addons
data_dir = /etc/odoo
logfile = /etc/odoo/odoo-server.log
log_level = info

; Senha mestra do Gerenciador de Bancos. Gerada aleatoriamente na instalação.
admin_passwd = __ADMIN_PASSWD__

; Várias bases por instância: a tela de login permite escolher a base, e o
; Gerenciador de Bancos (/web/database/manager) fica disponível. As operações
; do gerenciador são protegidas também por usuário e senha no proxy (Caddy).
list_db = True
; Para restringir a instância a uma base:  dbfilter = ^nome_da_base$
; dbfilter = .*

; Atrás de um proxy reverso (Caddy). Necessário para HTTPS e IP real do cliente.
proxy_mode = True

; Modo de produção com processos separados. Com workers > 0 o live chat e as
; notificações usam a porta interna 8072 (longpolling no 14/15, websocket do 16 em diante),
; encaminhada pelo proxy.
workers = 2
max_cron_threads = 1
limit_memory_soft = 805306368
limit_memory_hard = 1073741824
limit_time_cpu = 300
limit_time_real = 600
limit_request = 8192

; Não use dev_mode em produção.
; dev_mode = reload
