# Nginx na frente de uma instância do Odoo 15 (Docker), com HTTPS.
#
# 1. Copie para /etc/nginx/sites-available/<instancia> e ajuste:
#      SEU_DOMINIO -> ex.: erp.exemplo.com.br
#      INSTANCIA   -> nome curto e único, ex.: odoo15_one
#      10015       -> porta do Odoo   (ODOO_PORT no .env da instância)
#      20015       -> porta do chat   (CHAT_PORT no .env da instância)
# 2. ln -s /etc/nginx/sites-available/<instancia> /etc/nginx/sites-enabled/
# 3. nginx -t && systemctl reload nginx
# 4. certbot --nginx -d SEU_DOMINIO --redirect
#
# Para várias instâncias, repita com outro domínio e outras portas.

upstream odoo_INSTANCIA      { server 127.0.0.1:10015; }
upstream odoochat_INSTANCIA  { server 127.0.0.1:20015; }

server {
    listen 80;
    listen [::]:80;
    server_name SEU_DOMINIO;

    client_max_body_size 200m;
    proxy_read_timeout 720s;
    proxy_connect_timeout 720s;
    proxy_send_timeout 720s;

    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Real-IP $remote_addr;

    # Reforço: o gerenciador de bancos já está desativado (list_db = False).
    location ~ ^/web/database/ { return 403; }

    location /longpolling {
        proxy_pass http://odoochat_INSTANCIA;
    }

    location / {
        proxy_redirect off;
        proxy_pass http://odoo_INSTANCIA;
    }

    gzip on;
    gzip_types text/css text/plain text/xml application/xml application/javascript application/json;
}
